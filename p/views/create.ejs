<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profile ? 'Edit' : 'Create' %> Profile - Cookie Injection Proxy</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-slate-900 min-h-screen">
    <!-- Header -->
    <header class="bg-slate-800/50 backdrop-blur-md border-b border-slate-700/50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">🍪</span>
                    <h1 class="text-xl font-bold text-white">
                        <%= profile ? 'Edit Profile' : 'New Profile' %>
                    </h1>
                </div>
                <a href="/admin?token=<%= token %>"
                    class="text-slate-400 hover:text-white transition-colors text-sm">← Back</a>
            </div>
        </div>
    </header>

    <!-- Form -->
    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="bg-slate-800/60 backdrop-blur-sm rounded-2xl border border-slate-700/50 p-6 sm:p-8">
            <% if (error) { %>
                <div class="bg-red-500/20 border border-red-500/40 text-red-300 px-4 py-3 rounded-xl mb-6 text-sm">
                    <%= error %>
                </div>
            <% } %>

            <form method="POST"
                  action="<%= profile ? '/admin/edit/' + profile.id : '/admin/create' %>"
                  class="space-y-6">

                <input type="hidden" name="token" value="<%= token %>">

                <!-- Profile Name -->
                <div>
                    <label class="block text-slate-300 text-sm font-medium mb-2">Profile Name</label>
                    <input type="text" name="name" value="<%= profile ? profile.name : '' %>" required
                        placeholder="e.g. My Dashboard Access"
                        class="w-full px-4 py-3 rounded-xl bg-slate-900/50 border border-slate-700 text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                </div>

                <!-- Target URL -->
                <div>
                    <label class="block text-slate-300 text-sm font-medium mb-2">Target URL</label>
                    <input type="url" name="targetUrl" value="<%= profile ? profile.targetUrl : '' %>" required
                        placeholder="https://example.com/dashboard"
                        class="w-full px-4 py-3 rounded-xl bg-slate-900/50 border border-slate-700 text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                    <p class="text-slate-500 text-xs mt-1.5">The full URL of the page you want to proxy with cookies injected.</p>
                </div>

                <!-- Cookie Input -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-slate-300 text-sm font-medium">Cookies</label>
                        <div class="flex items-center gap-2 bg-slate-900/50 rounded-lg p-1 border border-slate-700">
                            <button type="button" id="formatJson" onclick="setFormat('json')"
                                class="px-3 py-1.5 rounded-md text-xs font-medium transition-colors bg-indigo-600 text-white">
                                JSON Array
                            </button>
                            <button type="button" id="formatRaw" onclick="setFormat('raw')"
                                class="px-3 py-1.5 rounded-md text-xs font-medium transition-colors text-slate-400 hover:text-white">
                                Raw String
                            </button>
                        </div>
                    </div>
                    <input type="hidden" name="cookieFormat" id="cookieFormat" value="json">

                    <!-- JSON format hint -->
                    <div id="jsonHint" class="mb-2">
                        <p class="text-slate-500 text-xs">Paste a JSON array of cookie objects:</p>
                        <pre class="text-slate-500 text-xs bg-slate-900/30 rounded-lg p-2 mt-1 overflow-x-auto"><code>[
    {"name": "session", "value": "abc123", "domain": ".example.com", "path": "/", "httpOnly": true, "secure": true},
    {"name": "token", "value": "xyz789", "domain": ".example.com", "path": "/"}
]</code></pre>
                    </div>

                    <!-- Raw format hint -->
                    <div id="rawHint" class="mb-2 hidden">
                        <p class="text-slate-500 text-xs">Paste raw cookie string(s), one per line:</p>
                        <pre class="text-slate-500 text-xs bg-slate-900/30 rounded-lg p-2 mt-1 overflow-x-auto"><code>session=abc123; Domain=.example.com; Path=/; HttpOnly; Secure
token=xyz789; Domain=.example.com; Path=/</code></pre>
                    </div>

                    <textarea name="cookieInput" id="cookieInput" rows="8"
                        placeholder='[{"name":"session","value":"abc123","domain":".example.com","path":"/"}]'
                        class="cookie-paste-area w-full px-4 py-3 rounded-xl bg-slate-900/50 border border-slate-700 text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"><%= profile ? JSON.stringify(profile.cookies, null, 2) : '' %></textarea>
                </div>

                <!-- Submit -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-700/50">
                    <a href="/admin?token=<%= token %>"
                        class="px-6 py-3 rounded-xl bg-slate-700 text-slate-300 text-sm font-medium hover:bg-slate-600 transition-colors">
                        Cancel
                    </a>
                    <button type="submit"
                        class="px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-semibold hover:from-indigo-500 hover:to-purple-500 transition-all duration-200 shadow-lg shadow-indigo-500/25">
                        <%= profile ? 'Update Profile' : 'Create Profile' %>
                    </button>
                </div>
            </form>
        </div>

        <!-- Quick Tips -->
        <div class="mt-6 bg-slate-800/30 rounded-xl border border-slate-700/30 p-6">
            <h3 class="text-sm font-semibold text-slate-300 mb-3">💡 Tips</h3>
            <ul class="space-y-2 text-xs text-slate-400">
                <li>• <span class="text-indigo-400 font-mono">__Secure-</span> prefixed cookies require the <span class="text-emerald-400">Secure</span> flag.</li>
                <li>• <span class="text-indigo-400 font-mono">__Host-</span> prefixed cookies require both <span class="text-emerald-400">Secure</span> and <span class="text-emerald-400">Path=/</span>.</li>
                <li>• The proxy rewrites links and redirects so the target site works seamlessly.</li>
                <li>• Use the <strong>Test Proxy</strong> button on the dashboard to verify the target is reachable.</li>
            </ul>
        </div>
    </main>

    <script>
        // Toggle cookie format
        function setFormat(format) {
            document.getElementById('cookieFormat').value = format;
            document.getElementById('formatJson').className = 'px-3 py-1.5 rounded-md text-xs font-medium transition-colors ' +
                (format === 'json' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white');
            document.getElementById('formatRaw').className = 'px-3 py-1.5 rounded-md text-xs font-medium transition-colors ' +
                (format === 'raw' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white');
            document.getElementById('jsonHint').classList.toggle('hidden', format !== 'json');
            document.getElementById('rawHint').classList.toggle('hidden', format !== 'raw');

            if (format === 'raw' && document.getElementById('cookieInput').value.startsWith('[')) {
                document.getElementById('cookieInput').value = '';
            }
        }

        // Pre-fill raw format hint if existing cookies look like raw
        <% if (profile) { %>
            // Keep JSON format as default for edit
        <% } %>
    </script>
</body>
</html>
