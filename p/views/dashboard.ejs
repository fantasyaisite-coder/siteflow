<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Cookie Proxy</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <h1 class="text-xl font-bold text-indigo-600">Cookie Proxy Tool</h1>
                </div>
                <div class="flex items-center">
                    <a href="/admin/logout" class="text-gray-500 hover:text-red-500 font-medium">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Success/Error Messages -->
        <% if (msg) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert"><%= msg %></div>
        <% } %>
        <% if (error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert"><%= error %></div>
        <% } %>

        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800">Injection Profiles</h2>
            <button onclick="openModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded">+ New Profile</button>
        </div>

        <!-- Profiles List -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (profiles.length === 0) { %>
                <div class="col-span-3 text-center py-12 text-gray-500">No profiles yet. Create one to get started!</div>
            <% } else { %>
                <% profiles.forEach(profile => { %>
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                        <h3 class="text-lg font-bold text-gray-900 mb-1"><%= profile.name %></h3>
                        <p class="text-sm text-gray-500 mb-4 truncate" title="<%= profile.targetUrl %>">
                            Target: <a href="<%= profile.targetUrl %>" target="_blank" class="text-indigo-500 hover:underline"><%= profile.targetUrl %></a>
                        </p>
                        
                        <div class="bg-gray-50 p-3 rounded border border-gray-100 mb-4">
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Shareable Proxy Link</label>
                            <div class="flex items-center">
                                <input type="text" readonly value="<%= baseUrl %>/go/<%= profile.id %>" class="flex-1 text-sm bg-transparent outline-none text-gray-700 mr-2">
                                <button onclick="copyLink('<%= baseUrl %>/go/<%= profile.id %>')" class="text-xs bg-gray-200 hover:bg-gray-300 px-2 py-1 rounded">Copy</button>
                            </div>
                        </div>

                        <!-- NEW: Bookmarklet Generator for Strict Sites -->
                        <div class="bg-yellow-50 p-3 rounded border border-yellow-100 mb-4">
                            <label class="block text-xs font-semibold text-yellow-700 mb-1">Inject without Proxy (Bookmarklet)</label>
                            <p class="text-xs text-yellow-600 mb-2">Drag this link to your bookmarks bar. Go to the target site manually, then click the bookmark to inject cookies directly into your real browser.</p>
                            
                            <% 
                                // Generate the JavaScript to inject cookies via Bookmarklet
                                let jsCode = profile.cookies.map(c => {
                                    // HttpOnly cookies cannot be injected via JavaScript. We log a warning.
                                    if (c.httpOnly) return `console.warn('Cannot inject HttpOnly cookie: ${c.name}');`;
                                    return `document.cookie='${c.name}=${c.value};path=${c.path || '/'};domain=${c.domain || ''}${c.secure ? ';secure' : ''}${c.sameSite ? ';SameSite=${c.sameSite}' : ''}';`;
                                }).join('\\n');
                                jsCode += `\\nalert('Cookies Injected! Refreshing page...'); location.reload();`;
                            %>

                            <a href="javascript:<%= jsCode %>" class="inline-block text-sm bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-1 px-3 rounded shadow-sm cursor-move">
                                🍪 Inject <%= profile.name %>
                            </a>
                            <p class="text-xs text-red-500 mt-2 font-medium">*Will not work if cookies are marked as HttpOnly.</p>
                        </div>

                        <div class="flex justify-between items-center">
                            <a href="/go/<%= profile.id %>" target="_blank" class="text-sm text-green-600 hover:text-green-800 font-medium">✓ Test Proxy</a>
                            <form action="/admin/profile/<%= profile.id %>/delete?_method=DELETE" method="POST">
                                <button type="submit" class="text-sm text-red-500 hover:text-red-700 font-medium">Delete</button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <!-- Create Profile Modal -->
    <div id="profileModal" class="hidden fixed inset-0 bg-gray-800 bg-opacity-75 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg m-4 overflow-hidden">
            <div class="p-6 border-b border-gray-200">
                <h3 class="text-lg font-bold text-gray-900">Create New Profile</h3>
            </div>
            <form action="/admin/profile" method="POST" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Profile Name</label>
                    <input type="text" name="name" required class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g. John's Session">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Target URL</label>
                    <input type="url" name="targetUrl" required class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="https://example.com/dashboard">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Cookies</label>
                    <select id="cookieFormat" name="cookieFormat" onchange="toggleCookieInput()" class="w-full border border-gray-300 rounded px-3 py-2 mb-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="json">JSON Array Format</option>
                        <option value="raw">Raw String Format</option>
                    </select>
                    <div id="jsonHelp" class="text-xs text-gray-500 mb-2">Paste full cookie JSON array (Export from EditThisCookie, etc.)</div>
                    <div id="rawHelp" class="hidden text-xs text-gray-500 mb-2">Paste raw cookie string (e.g., <code>sessionid=123; token=abc</code>)</div>
                    <textarea name="cookies" rows="6" required class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 font-mono text-sm" placeholder='[{"name":"session","value":"123","domain":".example.com","path":"/","secure":true}]'></textarea>
                </div>
                <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 text-gray-700 bg-gray-100 hover:bg-gray-200 rounded">Cancel</button>
                    <button type="submit" class="px-4 py-2 text-white bg-indigo-600 hover:bg-indigo-700 rounded font-medium">Save Profile</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal() { document.getElementById('profileModal').classList.remove('hidden'); }
        function closeModal() { document.getElementById('profileModal').classList.add('hidden'); }
        function toggleCookieInput() {
            const format = document.getElementById('cookieFormat').value;
            const ta = document.querySelector('textarea[name="cookies"]');
            if (format === 'json') {
                document.getElementById('jsonHelp').classList.remove('hidden');
                document.getElementById('rawHelp').classList.add('hidden');
                ta.placeholder = '[{"name":"session","value":"123","domain":".example.com","path":"/","secure":true}]';
            } else {
                document.getElementById('jsonHelp').classList.add('hidden');
                document.getElementById('rawHelp').classList.remove('hidden');
                ta.placeholder = 'session=123; token=abc';
            }
        }
        function copyLink(link) { navigator.clipboard.writeText(link).then(() => alert('Link copied to clipboard!')); }
    </script>
</body>
</html>
